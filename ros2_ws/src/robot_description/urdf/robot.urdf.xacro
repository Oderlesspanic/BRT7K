<?xml version="1.0"?>
<robot name="BRT7K" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--  all measuremts are in meter and radiant ! -->
  <!-- =========================
       Parameter
  ========================== -->
  <xacro:property name="base_length" value="0.30"/>
  <xacro:property name="base_width"  value="0.20"/>
  <xacro:property name="base_height" value="0.08"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.02"/>
  <xacro:property name="wheel_x"      value="0.0"/>
  <xacro:property name="wheel_y"      value="0.11"/>
  <xacro:property name="wheel_z"      value="-0.05"/>

  <!-- Sensorpositionen -->
  <xacro:property name="laser_x" value="0.12"/>
  <xacro:property name="laser_y" value="0.0"/>
  <xacro:property name="laser_z" value="0.12"/>

  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.04"/>

  <xacro:property name="mag_x" value="0.0"/>
  <xacro:property name="mag_y" value="0.0"/>
  <xacro:property name="mag_z" value="0.04"/>

  <xacro:property name="camera_x" value="0.14"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.16"/>

  <!-- =========================
       Farben
  ========================== -->
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.2 0.8 0.2 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>

  <!-- =========================
       Base Link
  ========================== -->
  <link name="base_link">

    <!-- 
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    -->

    <visual>
      <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>

   <!-- linker U-Schenkel -->
  <collision>
    <origin xyz="0.10 0.12 0.05" rpy="0 0 0"/>
    <geometry>
      <box size="0.40 0.04 0.10"/>
    </geometry>
  </collision>

  <!-- rechter U-Schenkel -->
  <collision>
    <origin xyz="0.10 -0.12 0.05" rpy="0 0 0"/>
    <geometry>
      <box size="0.40 0.04 0.10"/>
    </geometry>
  </collision>

  <!-- hinterer Steg -->
  <collision>
    <origin xyz="-0.10 0.0 0.05" rpy="0 0 0"/>
    <geometry>
      <box size="0.08 0.28 0.10"/>
    </geometry>
  </collision>
</link>

  <!-- =========================
       Wheel Macro
  ========================== -->
  <xacro:macro name="wheel" params="name x y z">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Räder -->
  <xacro:wheel name="left_wheel_link"  x="${wheel_x}" y="${wheel_y}"  z="${wheel_z}"/>
  <xacro:wheel name="right_wheel_link" x="${wheel_x}" y="-${wheel_y}" z="${wheel_z}"/>

  <!-- =========================
       LiDAR
  ========================== -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       IMU
  ========================== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.01"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       Magnetometer
  ========================== -->
  <link name="magnetometer_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="magnetometer_joint" type="fixed">
    <parent link="base_link"/>
    <child link="magnetometer_link"/>
    <origin xyz="${mag_x} ${mag_y} ${mag_z}" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       Kamera
  ========================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>

  <!-- Optischer Kamerarahmen -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

</robot>